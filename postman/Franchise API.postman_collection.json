{
  "info": {
    "name": "Franchise API",
    "description": "Prueba secuencial de franquicias, sucursales y productos. Ejecuta las solicitudes en orden; los IDs se guardan automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "franquiciaId", "value": "" },
    { "key": "sucursalId", "value": "" },
    { "key": "sucursalNorteId", "value": "" },
    { "key": "productoId", "value": "" },
    { "key": "productoNorteId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Crear franquicia",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Franquicia Postman\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/franquicias"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creada (201)', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('franquiciaId', pm.response.json().id);"] } }]
    },
    {
      "name": "2. Crear sucursal Centro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Centro\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/franquicias/{{franquiciaId}}/sucursales"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creada (201)', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('sucursalId', pm.response.json().id);"] } }]
    },
    {
      "name": "3. Crear sucursal Norte",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Norte\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/franquicias/{{franquiciaId}}/sucursales"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creada (201)', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('sucursalNorteId', pm.response.json().id);"] } }]
    },
    {
      "name": "4. Agregar producto Cafe a Centro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Cafe\",\n  \"stock\": 25\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/sucursales/{{sucursalId}}/productos"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creado (201)', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('productoId', pm.response.json().id);"] } }]
    },
    {
      "name": "5. Agregar producto Te a Centro",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Te\",\n  \"stock\": 35\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/sucursales/{{sucursalId}}/productos"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creado (201)', () => pm.response.to.have.status(201));"] } }]
    },
    {
      "name": "6. Agregar producto Agua a Norte",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Agua\",\n  \"stock\": 12\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/sucursales/{{sucursalNorteId}}/productos"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Creado (201)', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('productoNorteId', pm.response.json().id);"] } }]
    },
    {
      "name": "7. Consultar máximo stock por sucursal",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/franquicias/{{franquiciaId}}/max-stock" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consulta exitosa', () => pm.response.to.have.status(200));", "pm.test('Una fila por sucursal con productos', () => pm.response.json().length === 2);"] } }]
    },
    {
      "name": "8. Actualizar stock de Cafe",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"stock\": 50\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/productos/{{productoId}}/stock"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualizado (200)', () => pm.response.to.have.status(200));", "pm.test('Stock actualizado', () => pm.response.json().stock === 50);"] } }]
    },
    {
      "name": "9. Renombrar producto Cafe",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Cafe Premium\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/productos/{{productoId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualizado (200)', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "10. Renombrar sucursal Centro",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Centro renovada\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/sucursales/{{sucursalId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualizada (200)', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "11. Renombrar franquicia",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Franquicia Postman actualizada\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/franquicias/{{franquiciaId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Actualizada (200)', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "12. Eliminar producto Agua",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/productos/{{productoNorteId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Eliminado (204)', () => pm.response.to.have.status(204));"] } }]
    },
    {
      "name": "13. Listar franquicias",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/franquicias" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consulta exitosa', () => pm.response.to.have.status(200));"] } }]
    }
  ]
}